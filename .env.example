# ============================================================================
# Environment Variables
# Copy this file to .env and fill in your values.
# All VITE_* variables are injected at build time via import.meta.env.
# ============================================================================

# Sub-path deployments: set to the path prefix your app is served under.
# Example: VITE_BASE_PATH=/app  →  serve at https://example.com/app/
# Default: /
VITE_BASE_PATH=/

# Set to "false" to disable the mock auth and use real API calls (see authApi.js).
# Default: true (mock active)
VITE_USE_MOCK_AUTH=true

# Set to "false" to disable the mock org fetch and use real API calls (see orgApi.js).
# Default: true (mock active)
VITE_USE_MOCK_ORG=true

# Base URL for your real API (used in TODO sections of *Api.js files).
# Example: VITE_API_URL=https://api.example.com/v1
VITE_API_URL=
